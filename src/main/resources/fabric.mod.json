  "name": "MTVisuals",
  "description": "Локальные 3D-визуалы, косметика, хит-эффекты, управление временем и кибер-HUD для Minecraft 1.21.4",
  "authors": [
    "Ars3nBar"
  ],
  "environment": "client",
  "entrypoints": {
